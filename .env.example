# Скопируйте этот файл в .env и заполните секреты.
# .env не коммитится в git.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Прокси для Telegram. Пусто — без прокси. Пример: http://127.0.0.1:10809
TELEGRAM_PROXY=

# --- LLM (OpenAI-совместимый API) ---
# Ключ ProxyAPI или другого OpenAI-совместимого провайдера
OPENAI_API_KEY=sk-ваш-ключ
# Базовый URL API. Для ProxyAPI: https://api.proxyapi.ru/v1
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
# Основная и запасная модели
DEFAULT_MODEL=openai/gpt-4.1-mini
FALLBACK_MODEL=deepseek/deepseek-chat
# Температура ниже 0.5 делает ответы продавца стабильнее
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=650
REQUEST_TIMEOUT=60

# --- MCP-сервер ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# URL, по которому бот обращается к серверу
MCP_URL=http://127.0.0.1:8000/mcp
MCP_TIMEOUT=30
MCP_READ_TIMEOUT=60

# --- Ограничения агента (экономия токенов) ---
MAX_TOOL_ROUNDS=5
MAX_TOOL_RESULT_CHARS=5000
# Сколько раз автоматически продолжать ответ при finish_reason="length"
MAX_CONTINUATIONS=2

# --- История диалога ---
HISTORY_LIMIT=12
HISTORY_MAX_CHARS=9000
MAX_MESSAGE_CHARS=4000
HISTORY_FILE=data/history.json
# Настройки чатов: выбранная длина ответа
PREFERENCES_FILE=data/preferences.json
LOG_FILE=data/bot.log

# --- Напоминание о заявке ---
# Пауза в секундах после последнего сообщения пользователя. 0 — выключить.
REMINDER_DELAY_SECONDS=120
# Как часто бот опрашивает MCP-сервер о созревших напоминаниях, секунд.
REMINDER_POLL_SECONDS=15
# Текст напоминания. Пусто — встроенный текст по умолчанию.
REMINDER_TEXT=

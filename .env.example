# Скопируйте этот файл в .env и заполните своими значениями.
# .env нельзя отправлять в git и показывать другим людям.

# --- LLM (OpenAI-совместимый API) ---
# Ключ из ProxyAPI (или OpenAI, если используете его напрямую)
OPENAI_API_KEY=sk-ваш-ключ
# Адрес API. Для ProxyAPI: https://api.proxyapi.ru/v1
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
# Основная модель
DEFAULT_MODEL=openai/gpt-4.1-mini
# Запасная модель, если основная недоступна (можно оставить пустой)
FALLBACK_MODEL=deepseek/deepseek-chat
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=600
REQUEST_TIMEOUT=60

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Прокси для Telegram. Пример: http://127.0.0.1:10809
# Если прокси не нужен — оставьте пустым.
TELEGRAM_PROXY=

# --- Прокси для обычных HTTP-запросов (необязательно) ---
# Если пусто, используется TELEGRAM_PROXY.
# HTTP_PROXY_URL=http://127.0.0.1:10809

# --- Память и файлы ---
HISTORY_LIMIT=20
# Пути можно не указывать — по умолчанию всё лежит в корне проекта.
# MEMORY_FILE=memory.json
# REMINDERS_FILE=reminders.json
# WORKSPACE_DIR=workspace
# LOG_FILE=bot.log

# Как часто бот проверяет напоминания (секунды)
REMINDER_CHECK_INTERVAL=30
